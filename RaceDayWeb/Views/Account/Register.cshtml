@model RegisterViewModel
@{
    ViewData["Title"] = "Join RaceDay";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card rd-card p-4">
            <h1 class="rd-title mb-3">Join RaceDay</h1>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label class="form-label">I want to join as</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="roleParticipant" />
                        <label class="btn btn-outline-rd" for="roleParticipant">Participant</label>
                        <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="roleOrganiser" />
                        <label class="btn btn-outline-rd" for="roleOrganiser">Organiser</label>
                    </div>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Surname" class="form-label"></label>
                        <input asp-for="Surname" class="form-control" />
                        <span asp-validation-for="Surname" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Cell" class="form-label"></label>
                    <input asp-for="Cell" class="form-control" placeholder="0712345678" />
                    <div class="form-text">10 digits, for example 0712345678.</div>
                    <span asp-validation-for="Cell" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters, with a number and a symbol.</div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-rd w-100">Create account</button>
            </form>

            <p class="text-center mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}