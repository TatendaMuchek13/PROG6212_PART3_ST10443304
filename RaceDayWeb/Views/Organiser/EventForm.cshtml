@model EventFormModel
@{
    bool isNew = Model.EventID == 0;
    string formAction = isNew ? "CreateEvent" : "EditEvent";
    int? routeId = isNew ? null : Model.EventID;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card rd-card p-4">
            <h1 class="rd-title mb-3">@(isNew ? "Create event" : "Edit event")</h1>

            <form method="post" enctype="multipart/form-data" asp-action="@formAction" asp-route-id="@routeId">
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="EventID" />
                <input type="hidden" asp-for="BannerUrl" />

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" maxlength="100" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateOfEvent" class="form-label"></label>
                        <input asp-for="DateOfEvent" type="datetime-local" class="form-control" />
                        <span asp-validation-for="DateOfEvent" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Choose a type</option>
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.BannerUrl))
                    {
                        <div class="mb-2">
                            <img class="rd-thumb-lg" src="@Model.BannerUrl" alt="Current banner" />
                            <div class="form-text">Current banner. Choose a new file below to replace it.</div>
                        </div>
                    }
                    <input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" />
                    <div class="form-text">JPEG, PNG or WebP, up to 5 MB.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-rd">Save event</button>
                    <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
