@model EnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<h1 class="rd-title mb-3">Enrolments</h1>

<partial name="_EventPicker" model="Model" />

@if (Model.SelectedEvent != null)
{
    int confirmed = Model.Enrolments.Count(e => e.Status == "Confirmed");
    int pending = Model.Enrolments.Count(e => e.Status == "Pending");
    int cancelled = Model.Enrolments.Count(e => e.Status == "Cancelled");

    <div class="d-flex gap-2 mb-3 flex-wrap">
        <span class="status-badge status-confirmed">@confirmed confirmed</span>
        <span class="status-badge status-pending">@pending pending</span>
        <span class="status-badge status-cancelled">@cancelled cancelled</span>
    </div>

    <div class="card rd-card p-3 table-responsive">
        @if (Model.Enrolments.Count == 0)
        {
            <p class="text-muted p-3 mb-0">Nobody has enrolled for this event yet.</p>
        }
        else
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolled</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrolments.OrderBy(x => x.ParticipantName))
                    {
                        <tr>
                            <td class="fw-semibold">@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td>@e.DateOfEnroll.ToString("dd MMM yyyy")</td>
                            <td><span class="status-badge status-@e.Status.ToLower()">@e.Status</span></td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    @if (e.Status == "Pending")
                                    {
                                        <form asp-action="UpdateEnrolmentStatus" asp-route-id="@e.EnrollID" method="post">
                                            <input type="hidden" name="eventId" value="@Model.SelectedEvent.EventID" />
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button type="submit" class="btn btn-sm btn-rd">Confirm</button>
                                        </form>
                                    }
                                    @if (e.Status != "Cancelled")
                                    {
                                        <form asp-action="UpdateEnrolmentStatus" asp-route-id="@e.EnrollID" method="post"
                                              onsubmit="return confirm('Cancel this enrolment?');">
                                            <input type="hidden" name="eventId" value="@Model.SelectedEvent.EventID" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}