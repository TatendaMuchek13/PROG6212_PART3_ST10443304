@{
    string? role = Context.Session.GetString("Role");
    string? userName = Context.Session.GetString("UserName");
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string controller, string action)
    {
        return controller == currentController && action == currentAction ? " active" : "";
    }

    string AlertClass(string kind)
    {
        return kind == "Success" ? "alert-success" : kind == "Error" ? "alert-danger" : "alert-info";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(role == "Organiser" ? "role-organiser" : role == "Participant" ? "role-participant" : "role-guest")">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav"
                        aria-controls="rdNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="rdNav">
                    <ul class="navbar-nav me-auto">
                        @if (role == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link@(Active("Organiser", "Dashboard"))" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Organiser", "Events"))" asp-controller="Organiser" asp-action="Events">Events</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Organiser", "Categories"))" asp-controller="Organiser" asp-action="Categories">Categories</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Organiser", "Enrolments"))" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Organiser", "Results"))" asp-controller="Organiser" asp-action="Results">Results</a></li>
                        }
                        else if (role == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link@(Active("Events", "Index"))" asp-controller="Events" asp-action="Index">Upcoming events</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Participant", "Enrolments"))" asp-controller="Participant" asp-action="Enrolments">My enrolments</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Participant", "Results"))" asp-controller="Participant" asp-action="Results">My results</a></li>
                            <li class="nav-item"><a class="nav-link@(Active("Participant", "Profile"))" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (role != null)
                        {
                            <span class="rd-role-badge">@role</span>
                            <span class="text-white-50 small d-none d-lg-inline">@userName</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-rd btn-sm" asp-controller="Account" asp-action="Register">Join</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @foreach (var kind in new[] { "Success", "Info", "Error" })
            {
                if (TempData[kind] is string message)
                {
                    <div class="alert @AlertClass(kind) alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">&copy; 2026 RaceDay &middot; Runs, walks and rides</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>